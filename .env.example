# Copy to .env and fill in values:
#   copy .env.example .env

NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3000
# Path prefix on EC2 nginx (leave empty when P&L is at site root). Example: /pnl
NEXT_BASE_PATH=

# --- EC2 (http://13.201.19.145) — set these on the server before npm run build ---
# NEXT_PUBLIC_APP_URL=http://13.201.19.145
# AUTH_URL=http://13.201.19.145
# PNL_PUBLIC_URL=http://13.201.19.145
# PORTAL_PUBLIC_URL=http://13.201.19.145/ws
# NEXT_PUBLIC_PORTAL_PUBLIC_URL=http://13.201.19.145/ws
# WORKSPACE_PUBLIC_URL=http://13.201.19.145/ws
# WORKSPACE_API_URL=http://13.201.19.145/ws-api
# SSO_SECRET must match Installation_backend SSO_SECRET

# --- P&L only (portal login lives on Installation_frontend) ---
# Same secret must be set on Installation_backend as SSO_SECRET
SSO_SECRET=
PNL_PUBLIC_URL=http://localhost:3000
# Installation portal (login + /apps) — used for redirects + Apps header link
PORTAL_PUBLIC_URL=http://localhost:5173
NEXT_PUBLIC_PORTAL_PUBLIC_URL=http://localhost:5173
WORKSPACE_PUBLIC_URL=http://localhost:5173
WORKSPACE_API_URL=http://localhost:5000
# Still used for "Apps" header visibility (multi-app users)
CENTRAL_BOTH_EMAILS=gauravjain@atlantatelecables.com,gauravjain@gmail.com,mansi@gmail.com
CENTRAL_PNL_EMAILS=
CENTRAL_WORKSPACE_EMAILS=
CENTRAL_PNL_DEFAULT=false

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=

# Local Docker: postgresql://postgres:postgres@127.0.0.1:5432/plant_pnl
# To see the SAME data as AWS Amplify (and write data that appears on AWS):
#   1. Amplify Console → your app → Hosting → Environment variables
#   2. Copy DATABASE_URL exactly into this file (replace the line below)
#   3. Restart: stop npm run dev, then npm run dev again
# WARNING: you will be reading/writing the live production database.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/plant_pnl

SUPER_ADMIN_EMAIL=admin@local.test
SUPER_ADMIN_PASSWORD=
# Only this Super Admin may activate/deactivate other Super Admins.
PRIMARY_SUPER_ADMIN_EMAIL=gauravjain@gmail.com
# Only this Super Admin may edit Quad/Signal Opening stock anytime (Tarun Jain).
OPENING_STOCK_EDITOR_EMAIL=tarun@gmail.com
PLANT_MANAGER_EMAIL=manager@cat6.local
PLANT_MANAGER_PASSWORD=
MACHINE_SUPERVISOR_EMAIL=supervisor@machine.local
MACHINE_SUPERVISOR_PASSWORD=

CRON_SECRET=
# Entries on/after this date require Super Admin approval (YYYY-MM-DD).
# Use a fixed date — defaulting to "today" hid yesterday's pending queue.
SHIFT_APPROVAL_START_DATE=2026-08-01

# Media uploads — ACTIVE: Cloudinary
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

